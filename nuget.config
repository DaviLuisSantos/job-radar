<?xml version="1.0" encoding="utf-8"?>
<!-- Only nuget.org: builds are reproducible on any machine and in CI, whatever sources the user has. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
