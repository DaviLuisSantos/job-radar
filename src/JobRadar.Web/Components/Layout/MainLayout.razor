@inherits LayoutComponentBase
@implements IDisposable
@inject Backend Backend
@inject ProfileCatalog Catalog
@inject NavigationManager Nav
@inject TimeProvider Time
@inject IJSRuntime JS

@* Light palette only: the dark one is CSS in the page head (JobRadarTheme.DarkCss), so the prerender is right too. *@
<MudThemeProvider Theme="JobRadarTheme.Theme" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <header class="topbar">
        <div class="topbar-row">
            <button type="button" class="icon-button drawer-toggle" aria-label="@Wording.Menu" @onclick="() => _drawer = true">
                <Icon Path="@Icons.Material.Rounded.Menu" />
            </button>
            <a class="brand" href="/">
                <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13" /><circle cx="16" cy="16" r="4" class="dot" /></svg>
                <span>JobRadar</span>
            </a>
            @if (_groups.Count > 1)
            {
                <nav class="markets" aria-label="@Wording.Markets">
                    @foreach (var group in _groups)
                    {
                        <a href="@ProfileMenu.TodayHref(group.Market)" class="market @(group.Market == _market ? "active" : "")"
                           aria-current="@(group.Market == _market ? "true" : null)">
                            @group.Label
                            <NewCount Count="_newCounts.GetValueOrDefault(group.Market)" />
                        </a>
                    }
                </nav>
                <MudMenu Class="market-menu" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" AriaLabel="@Wording.Markets">
                    <ActivatorContent>
                        <button type="button" class="market-current" aria-haspopup="menu" @onclick="context.ToggleAsync">
                            @CurrentGroup?.Label
                            <NewCount Count="_newCounts.Where(c => c.Key != _market).Sum(c => c.Value)" />
                            <Icon Path="@Icons.Material.Rounded.ExpandMore" />
                        </button>
                    </ActivatorContent>
                    <ChildContent>
                        @foreach (var group in _groups)
                        {
                            <MudMenuItem Href="@ProfileMenu.TodayHref(group.Market)">
                                <span class="menu-market">@group.Label <NewCount Count="_newCounts.GetValueOrDefault(group.Market)" /></span>
                            </MudMenuItem>
                        }
                    </ChildContent>
                </MudMenu>
            }
            <span class="spacer"></span>
            <button type="button" class="icon-button" title="@Wording.ThemeTitle(_theme)" aria-label="@Wording.ThemeTitle(_theme)" @onclick="NextThemeAsync">
                <Icon Path="@ThemeIcon" />
            </button>
            <MudMenu Icon="@Icons.Material.Outlined.Settings" Color="Color.Inherit" AriaLabel="@Wording.Settings" Class="settings-menu"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                @foreach (var (href, label, icon) in SettingsPages)
                {
                    <MudMenuItem Href="@href" Icon="@icon">@label</MudMenuItem>
                }
            </MudMenu>
        </div>
        @if (CurrentGroup is { Profiles.Count: > 0 } current)
        {
            <nav class="profile-bar" aria-label="@Wording.ProfilesOf(current.Label)">
                <NavLink href="@ProfileMenu.TodayHref(current.Market)" Match="NavLinkMatch.All">@Wording.Today</NavLink>
                @foreach (var profile in current.Profiles)
                {
                    <NavLink href="@TriageHref(profile)" Match="NavLinkMatch.All">@profile</NavLink>
                }
            </nav>
        }
    </header>

    <MudDrawer @bind-Open="_drawer" Variant="DrawerVariant.Temporary" Anchor="Anchor.Start" Elevation="2" Width="min(320px, 86vw)" Class="drawer">
        <div class="drawer-head">
            <a class="brand" href="/" @onclick="() => _drawer = false">
                <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13" /><circle cx="16" cy="16" r="4" class="dot" /></svg>
                <span>JobRadar</span>
            </a>
            <button type="button" class="icon-button" aria-label="@Wording.Close" @onclick="() => _drawer = false">
                <Icon Path="@Icons.Material.Rounded.Close" />
            </button>
        </div>
        <nav class="drawer-nav" aria-label="@Wording.Menu">
            @foreach (var group in _groups)
            {
                <p class="drawer-section">@group.Label <NewCount Count="_newCounts.GetValueOrDefault(group.Market)" /></p>
                <NavLink href="@ProfileMenu.TodayHref(group.Market)" Match="NavLinkMatch.All" @onclick="() => _drawer = false">
                    <Icon Path="@Icons.Material.Outlined.WbSunny" /> @Wording.Today
                </NavLink>
                @foreach (var profile in group.Profiles)
                {
                    <NavLink href="@TriageHref(profile)" Match="NavLinkMatch.All" @onclick="() => _drawer = false">
                        <Icon Path="@Icons.Material.Outlined.FilterList" /> @profile
                    </NavLink>
                }
            }
            <p class="drawer-section">@Wording.Settings</p>
            @foreach (var (href, label, icon) in SettingsPages)
            {
                <NavLink href="@href" @onclick="() => _drawer = false"><Icon Path="@icon" /> @label</NavLink>
            }
        </nav>
    </MudDrawer>

    <MudMainContent>
        <main class="page">
            @Body
        </main>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    @Wording.SomethingWentWrong
    <a href="." class="reload">@Wording.Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private static readonly (string Href, string Label, string Icon)[] SettingsPages =
    [
        ("capture", Wording.CapturePage, Icons.Material.Outlined.BookmarkAdd),
        ("me", Wording.AboutYouPage, Icons.Material.Outlined.Person),
        ("requirements", Wording.RequirementsPage, Icons.Material.Outlined.Checklist),
        ("calibration", Wording.CalibrationPage, Icons.Material.Outlined.Tune),
        ("status", Wording.StatusPage, Icons.Material.Outlined.MonitorHeart),
    ];

    private static readonly string[] Themes = ["system", "light", "dark"];

    private bool _drawer;
    private string _theme = "system";
    private IReadOnlyList<ProfileGroup> _groups = [];
    private JobMarket _market = JobMarket.AU;
    private IReadOnlyDictionary<JobMarket, int> _newCounts = new Dictionary<JobMarket, int>();

    private ProfileGroup? CurrentGroup => _groups.FirstOrDefault(g => g.Market == _market);

    private string ThemeIcon => _theme switch
    {
        "light" => Icons.Material.Outlined.LightMode,
        "dark" => Icons.Material.Outlined.DarkMode,
        _ => Icons.Material.Outlined.BrightnessAuto,
    };

    private static string TriageHref(string profile) => $"triage/{Uri.EscapeDataString(profile)}";

    protected override async Task OnInitializedAsync()
    {
        _groups = ProfileMenu.Groups(Catalog.Profiles,
            await Backend.RunAsync<TriageService, IReadOnlyList<string>>(t => t.ProfilesAsync()));
        _market = _groups.FirstOrDefault()?.Market ?? JobMarket.AU;
        FollowLocation(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
        await CountNewAsync();
    }

    /// <summary>New listings per market since its last "Today": refreshed on every page change, cheap (filtered in the database).</summary>
    private async Task CountNewAsync()
    {
        var byMarket = _groups.ToDictionary(g => g.Market, g => g.Profiles);
        _newCounts = await Backend.RunAsync<TodayService, IReadOnlyDictionary<JobMarket, int>>(s => s.NewCountsAsync(byMarket, Time.GetUtcNow()));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        _theme = await JS.InvokeAsync<string?>("jobRadarTheme.get") ?? "system";
        StateHasChanged();
    }

    /// <summary>Automatic (the system's), light, dark: kept on this device by the script in the page head.</summary>
    private async Task NextThemeAsync()
    {
        _theme = Themes[(Array.IndexOf(Themes, _theme) + 1) % Themes.Length];
        await JS.InvokeVoidAsync("jobRadarTheme.set", _theme);
    }

    /// <summary>On a market's "Today" or a profile's triage, its market is the current one; elsewhere the last one stays.</summary>
    private void FollowLocation(string uri)
    {
        if (ProfileMenu.MarketOf(_groups, Nav.ToBaseRelativePath(uri)) is { } market)
            _market = market;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        FollowLocation(e.Location);
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await CountNewAsync();
            StateHasChanged();
        });
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
