@inherits LayoutComponentBase
@implements IDisposable
@inject Backend Backend
@inject ProfileCatalog Catalog
@inject NavigationManager Nav

<MudThemeProvider @ref="_themeProvider" Theme="JobRadarTheme.Theme" @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="appbar">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" Class="d-flex d-md-none"
                       aria-label="@Wording.Menu" OnClick="() => _drawer = !_drawer" />
        <a class="brand" href="/">
            <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13" /><circle cx="16" cy="16" r="4" class="dot" /></svg>
            JobRadar
        </a>
        @if (_groups.Count > 1)
        {
            <MudToggleGroup T="JobMarket" Value="_market" ValueChanged="GoToMarket" Size="Size.Medium" Color="Color.Primary"
                            Class="d-none d-md-flex ml-4" aria-label="@Wording.Markets">
                @foreach (var group in _groups)
                {
                    <MudToggleItem Value="group.Market" Text="@group.Label" />
                }
            </MudToggleGroup>
        }
        <MudSpacer />
        <MudMenu Icon="@Icons.Material.Outlined.Settings" Color="Color.Inherit" AriaLabel="@Wording.Settings"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="d-none d-md-flex">
            @foreach (var (href, label) in SettingsPages)
            {
                <MudMenuItem Href="@href">@label</MudMenuItem>
            }
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawer" Variant="DrawerVariant.Temporary" Anchor="Anchor.Start" Elevation="1">
        <MudNavMenu>
            @foreach (var group in _groups)
            {
                <MudNavGroup Title="@group.Label" Expanded="group.Market == _market">
                    @foreach (var profile in group.Profiles)
                    {
                        <MudNavLink Href="@TriageHref(profile)" Match="NavLinkMatch.All" OnClick="() => _drawer = false">@profile</MudNavLink>
                    }
                </MudNavGroup>
            }
            <MudDivider Class="my-2" />
            @foreach (var (href, label) in SettingsPages)
            {
                <MudNavLink Href="@href" OnClick="() => _drawer = false">@label</MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        @if (CurrentGroup is { Profiles.Count: > 0 } current)
        {
            <nav class="profile-bar" aria-label="@Wording.ProfilesOf(current.Label)">
                @foreach (var profile in current.Profiles)
                {
                    <NavLink href="@TriageHref(profile)" Match="NavLinkMatch.All">@profile</NavLink>
                }
            </nav>
        }
        <main class="page">
            @Body
        </main>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    @Wording.SomethingWentWrong
    <a href="." class="reload">@Wording.Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private static readonly (string Href, string Label)[] SettingsPages =
    [
        ("capture", Wording.CapturePage), ("me", Wording.AboutYouPage), ("requirements", Wording.RequirementsPage),
        ("calibration", Wording.CalibrationPage), ("status", Wording.StatusPage),
    ];

    private MudThemeProvider? _themeProvider;
    private bool _dark;
    private bool _drawer;
    private IReadOnlyList<ProfileGroup> _groups = [];
    private JobMarket _market = JobMarket.AU;

    private ProfileGroup? CurrentGroup => _groups.FirstOrDefault(g => g.Market == _market);

    private static string TriageHref(string profile) => $"triage/{Uri.EscapeDataString(profile)}";

    protected override async Task OnInitializedAsync()
    {
        _groups = ProfileMenu.Groups(Catalog.Profiles,
            await Backend.RunAsync<TriageService, IReadOnlyList<string>>(t => t.ProfilesAsync()));
        _market = _groups.FirstOrDefault()?.Market ?? JobMarket.AU;
        FollowLocation(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeProvider is null)
            return;
        _dark = await _themeProvider.GetSystemDarkModeAsync();
        await _themeProvider.WatchSystemDarkModeAsync(dark =>
        {
            _dark = dark;
            return InvokeAsync(StateHasChanged);
        });
        StateHasChanged();
    }

    /// <summary>On a profile's triage, its market is the current one; elsewhere the last one stays.</summary>
    private void FollowLocation(string uri)
    {
        if (ProfileMenu.MarketOf(_groups, Nav.ToBaseRelativePath(uri)) is { } market)
            _market = market;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        FollowLocation(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void GoToMarket(JobMarket market)
    {
        _market = market;
        if (CurrentGroup is { Profiles.Count: > 0 } group)
            Nav.NavigateTo(TriageHref(group.Profiles[0]));
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
