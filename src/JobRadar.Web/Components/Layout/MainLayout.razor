@inherits LayoutComponentBase
@inject Backend Backend
@inject ProfileCatalog Catalog

<header class="topbar">
    <a class="brand" href="/">
        <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13" /><circle cx="16" cy="16" r="4" class="dot" /></svg>
        JobRadar
    </a>
    <nav aria-label="Profiles">
        @foreach (var group in _groups)
        {
            @* One market needs no label: a single-country setup looks as it always did. *@
            @if (_groups.Count > 1)
            {
                <span class="market">@group.Label</span>
            }
            @foreach (var profile in group.Profiles)
            {
                <NavLink href="@($"triage/{Uri.EscapeDataString(profile)}")">@profile</NavLink>
            }
        }
        <NavLink href="capture" class="secondary">Capture</NavLink>
        <NavLink href="me" class="secondary">About you</NavLink>
        <NavLink href="requirements" class="secondary">Requirements</NavLink>
        <NavLink href="calibration" class="secondary">Calibration</NavLink>
        <NavLink href="status" class="secondary">Status</NavLink>
    </nav>
</header>

<main class="page">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private IReadOnlyList<ProfileGroup> _groups = [];

    protected override async Task OnInitializedAsync() =>
        _groups = ProfileMenu.Groups(Catalog.Profiles,
            await Backend.RunAsync<TriageService, IReadOnlyList<string>>(t => t.ProfilesAsync()));
}
