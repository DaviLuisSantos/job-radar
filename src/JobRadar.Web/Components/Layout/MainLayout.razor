@inherits LayoutComponentBase
@inject Backend Backend

<header class="topbar">
    <a class="brand" href="/">
        <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13" /><circle cx="16" cy="16" r="4" class="dot" /></svg>
        JobRadar <span>AU</span>
    </a>
    <nav aria-label="Profiles">
        @foreach (var profile in _profiles)
        {
            <NavLink href="@($"triage/{Uri.EscapeDataString(profile)}")">@profile</NavLink>
        }
        <NavLink href="capture" class="secondary">Capture</NavLink>
        <NavLink href="requirements" class="secondary">Requirements</NavLink>
        <NavLink href="calibration" class="secondary">Calibration</NavLink>
        <NavLink href="status" class="secondary">Status</NavLink>
    </nav>
</header>

<main class="page">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private IReadOnlyList<string> _profiles = [];

    protected override async Task OnInitializedAsync() =>
        _profiles = await Backend.RunAsync<TriageService, IReadOnlyList<string>>(t => t.ProfilesAsync());
}
