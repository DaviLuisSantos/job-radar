@* What decides an application, as the source gives it: who may apply, arrangement, contract, time zones. *@
@if (Eligibility is { Length: > 0 } eligibility)
{
    <span class="chip tag tag-eligibility" title="@eligibility">@Wording.Eligibility(eligibility)</span>
}
@if (Wording.Arrangement(Conditions.Arrangement) is { Length: > 0 } arrangement)
{
    <span class="chip tag tag-arrangement tag-@Conditions.Arrangement.ToString().ToLowerInvariant()">@arrangement</span>
}
@if (Conditions.Contract is { } contract)
{
    <span class="chip tag tag-contract">@contract</span>
}
@if (Conditions.TimeZones is { } zones)
{
    <span class="chip tag tag-timezones">@Wording.TimeZones(zones.ToString())</span>
}
@if (Engagement is { } engagement and not JobRadar.Domain.Matching.Engagement.Unknown)
{
    <span class="chip tag tag-engagement">@Wording.EngagementName(engagement)</span>
}

@code {
    [Parameter, EditorRequired] public ListingConditions Conditions { get; set; } = ListingConditions.None;

    /// <summary>Who may apply, from remote boards (<c>Listing.Eligibility</c>).</summary>
    [Parameter] public string? Eligibility { get; set; }

    /// <summary>How a remote job hires, when the profile reads it.</summary>
    [Parameter] public Engagement? Engagement { get; set; }
}
