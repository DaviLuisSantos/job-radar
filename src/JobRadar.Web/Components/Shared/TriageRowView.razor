@* One line of the triage list. An excluded one says, in one line, the rule that took it out. *@
<li class="row band-@Wording.Band(Row.Score) @(Current ? "current" : "") @(Busy ? "busy" : "") @(Row.Score == 0 ? "excluded" : "")"
    tabindex="-1" aria-current="@(Current ? "true" : null)" @onclick="OnSelect">
    <ScoreBadge Value="Row.Score" />
    <div class="what">
        <a class="title" href="@Href">@Row.Title</a>
        <div class="meta">
            <span class="company">@(Row.Company ?? "Empresa não informada")</span>
            <span>@Wording.Location(Row.Location)@(Row.OtherLocations.Count > 0 ? $" +{Row.OtherLocations.Count} outros" : "")</span>
            @if (Wording.WorkType(Row.WorkType) is { Length: > 0 } wt)
            {
                <span>@wt</span>
            }
            @if (Row.SalaryText is { } salary)
            {
                <span class="salary">@salary</span>
            }
        </div>
        @if (Row.Score == 0)
        {
            <p class="excluded-by">@(Row.ExcludedBy is { } item ? Wording.Describe(item) : Wording.ExcludedReasonUnknown)</p>
        }
        <div class="tags">
            <ListingTags Conditions="Row.Conditions" Eligibility="@Row.Eligibility" Engagement="Row.Engagement" />
            <FactChips Facts="Row.Facts" />
        </div>
    </div>
    <div class="state">
        <span class="age" title="@(Row.PostedAt is { } posted ? Wording.Date(posted) : null)">@Wording.Age(Row.PostedAt, Now)</span>
        @if (Row.Copies.Count > 0)
        {
            <span class="chip" title="@CopiesTitle">publicada @(Row.Copies.Count + 1)×</span>
        }
        @if (Row.Status is { } status)
        {
            <span class="chip status-@status.ToString().ToLowerInvariant()">@Wording.Status(status)</span>
        }
        @if (Row.Verdict is { } verdict)
        {
            <span class="chip verdict-@verdict.ToString().ToLowerInvariant()">@Wording.Verdict(verdict)</span>
        }
    </div>
    <div class="actions" role="group" aria-label="Triagem de @Row.Title">
        <button type="button" class="act good @(Row.Verdict == Verdict.Good ? "on" : "")" title="Boa (g)"
                aria-pressed="@(Row.Verdict == Verdict.Good ? "true" : "false")" @onclick="() => OnLabel.InvokeAsync(Verdict.Good)">
            <Icon Path="@Icons.Material.Outlined.ThumbUp" /><span>Boa</span>
        </button>
        <button type="button" class="act bad @(Row.Verdict == Verdict.Bad ? "on" : "")" title="Ruim (b)"
                aria-pressed="@(Row.Verdict == Verdict.Bad ? "true" : "false")" @onclick="() => OnLabel.InvokeAsync(Verdict.Bad)">
            <Icon Path="@Icons.Material.Outlined.ThumbDown" /><span>Ruim</span>
        </button>
        <button type="button" class="act applied" title="Marcar como Candidatei (conta como boa)"
                @onclick="() => OnStatus.InvokeAsync(ApplicationStatus.Applied)">
            <Icon Path="@Icons.Material.Outlined.Send" /><span>Candidatei</span>
        </button>
        <button type="button" class="act dismiss" title="Descartar: não é para mim (conta como ruim)"
                @onclick="() => OnStatus.InvokeAsync(ApplicationStatus.Dismissed)">
            <Icon Path="@Icons.Material.Outlined.DoNotDisturbOn" /><span>Descartar</span>
        </button>
    </div>
</li>

@code {
    [Parameter, EditorRequired] public TriageRow Row { get; set; } = default!;
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter] public DateTimeOffset Now { get; set; }
    [Parameter] public bool Current { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }
    [Parameter] public EventCallback<Verdict> OnLabel { get; set; }
    [Parameter] public EventCallback<ApplicationStatus> OnStatus { get; set; }

    private string CopiesTitle =>
        Row.OtherLocations.Count > 0 ? $"Também em: {string.Join(", ", Row.OtherLocations)}" : "Republicada com o mesmo título e a mesma empresa";
}
