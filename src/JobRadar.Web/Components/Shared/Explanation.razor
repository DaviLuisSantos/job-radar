@* Why a listing scored what it did, step by step from the base of 50, each step with a bar as long as its weight. *@
<ol class="explanation">
    @if (!Score.Excluded)
    {
        <li class="base"><span class="pts">@FitScore.Base</span><span class="what">Base</span></li>
    }
    @foreach (var item in Score.Items)
    {
        <li class="@Tone(item, Score)">
            <span class="pts">@Wording.Points(item.Points)</span>
            <span class="what">
                @Wording.Describe(item)
                @if (Wording.Where(item.Where) is { Length: > 0 } where)
                {
                    <span class="where">@where</span>
                }
            </span>
            <span class="bar" aria-hidden="true"><span style="width: @Share(item.Points)"></span></span>
        </li>
    }
    <li class="total">
        <span class="pts"><ScoreBadge Value="Score.Final" /></span>
        <span class="what">@(Score.Excluded ? "Excluída: nunca aparece" : "Nota final")</span>
    </li>
</ol>

@code {
    [Parameter, EditorRequired] public FitScore Score { get; set; } = default!;

    // The scorer stops at the first rule that excludes: in an excluded score, that rule is the last item.
    private static string Tone(ScoreItem item, FitScore score) => item.Points switch
    {
        _ when score.Excluded && ReferenceEquals(item, score.Items[^1]) => "exclusion",
        > 0 => "plus",
        < 0 => "minus",
        _ => "neutral",
    };

    /// <summary>A step's length against the largest step of this score (at least 25 points, so small scores stay small).</summary>
    private string Share(int points)
    {
        var largest = Math.Max(25, Score.Items.Count == 0 ? 0 : Score.Items.Max(i => Math.Abs(i.Points)));
        return $"{Math.Min(100, 100 * Math.Abs(points) / largest)}%";
    }
}
