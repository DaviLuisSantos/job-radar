@page "/me"
@inject Backend Backend

<PageTitle>Você · JobRadar</PageTitle>

<div class="page-head">
    <h1>Você</h1>
    <p class="muted">Onde você está em relação ao que os anúncios pedem. Cada resposta é salva na hora e as vagas que ela afeta ganham nota nova.</p>
</div>

@if (_message is not null)
{
    <p class="notice" role="status">@_message</p>
}

@if (_requirements is null || _experience is null)
{
    <p class="muted">Carregando…</p>
}
else
{
    <section class="about">
        <h2>Anos de experiência</h2>
        <p class="muted small">Em cada área. Quando um anúncio diz quantos anos quer, estes decidem: o bastante soma, um ano a menos tira um pouco, mais que isso tira mais.</p>
        <div class="cards">
            @foreach (var (profile, years) in _experience)
            {
                <div class="card">
                    <div class="card-head">
                        <b>@profile</b>
                        <span class="muted">@(years is { } y ? Wording.Years(y) : "não informado")</span>
                    </div>
                    <div class="chips" role="group" aria-label="@($"Anos em {profile}")">
                        @foreach (var option in YearOptions)
                        {
                            <button type="button" class="@(years == option ? "on" : null)" disabled="@Busy"
                                    @onclick="() => SetYearsAsync(profile, option)">@Wording.YearsShort(option)</button>
                        }
                        <input type="number" min="0" max="60" step="0.5" aria-label="@($"Outro número de anos em {profile}")"
                               placeholder="outro" disabled="@Busy" @onchange="e => SetYearsAsync(profile, ParseYears(e.Value as string))" />
                        @if (years is not null)
                        {
                            <button type="button" class="ghost" disabled="@Busy" @onclick="() => SetYearsAsync(profile, null)">Limpar</button>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    @foreach (var (kind, heading, intro) in Sections)
    {
        // Tickets a short course gives before truck licences, and truck classes from the lowest up.
        var items = _requirements.Where(r => r.Item.Kind == kind)
            .OrderBy(r => r.Item.IsTruckLicence)
            .ThenBy(r => Array.IndexOf(TruckOrder, r.Item.Id))
            .ToList();
        <section class="about">
            <h2>@heading</h2>
            <p class="muted small">@intro</p>
            <div class="cards">
                @foreach (var r in items)
                {
                    var (title, hint) = Wording.Requirement(r.Item.Id);
                    <div class="card">
                        <div class="card-head">
                            <b>@title</b>
                            @if (r.Profiles.Count > 0)
                            {
                                <span class="muted small">conta em @string.Join(", ", r.Profiles)</span>
                            }
                        </div>
                        @if (hint.Length > 0)
                        {
                            <p class="muted small">@hint</p>
                        }
                        <div class="segmented" role="group" aria-label="@title">
                            @foreach (var state in Enum.GetValues<RequirementState>())
                            {
                                <button type="button" class="@(r.State == state ? "on" : null)" aria-pressed="@(r.State == state ? "true" : "false")"
                                        disabled="@Busy" @onclick="() => SetStateAsync(r, state)">@Wording.StateButton(state)</button>
                            }
                        </div>
                        @if (r.IsDefault)
                        {
                            <p class="muted small">Ainda sem resposta: pesa como “@Wording.StateButton(r.State)”.</p>
                        }
                        else
                        {
                            <button type="button" class="link small" disabled="@Busy" @onclick="() => SetStateAsync(r, null)">Voltar ao padrão</button>
                        }
                    </div>
                }
            </div>
        </section>
    }

    <p class="muted small">Para ver quanto cada um mexe nas suas vagas, abra <a href="requirements">Requisitos</a>.</p>
}

@code {
    private static readonly double[] YearOptions = [0, 1, 2, 3, 5, 8, 10];

    private static readonly string[] TruckOrder = ["truck-mr", "truck-hr", "truck-hc", "truck-mc"];

    private static readonly (RequirementKind Kind, string Heading, string Intro)[] Sections =
    [
        (RequirementKind.Licence, "Licenças e tickets", "O que você tem, o que um curso curto daria e o que está a anos de distância."),
        (RequirementKind.Qualification, "Formações", "Ofícios e diplomas como a Austrália os reconhece."),
        (RequirementKind.Experience, "Experiência que o anúncio pede sem número", "Usada só quando o anúncio não dá o número de anos."),
    ];

    private IReadOnlyList<RequirementStatus>? _requirements;
    private IReadOnlyList<(string Profile, double? Years)>? _experience;
    private string? _message;
    private bool Busy { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _requirements = await Backend.RunAsync<CandidateRequirementService, IReadOnlyList<RequirementStatus>>(s => s.ListAsync());
        _experience = await Backend.RunAsync<CandidateRequirementService, IReadOnlyList<(string, double?)>>(s => s.ExperienceAsync());
    }

    private async Task SetStateAsync(RequirementStatus requirement, RequirementState? state)
    {
        if (!requirement.IsDefault && requirement.State == state)
            return;
        await SaveAsync(async () =>
        {
            var (_, rescored) = await Backend.RunAsync<CandidateRequirementService, (RequirementItem, int)>(s => s.SetAsync(requirement.Item.Id, state));
            var title = Wording.Requirement(requirement.Item.Id).Title;
            return $"{title}: {(state is { } s ? Wording.StateButton(s) : "de volta ao padrão")}. {Wording.Listings(rescored)} com nota nova.";
        });
    }

    private async Task SetYearsAsync(string profile, double? years) =>
        await SaveAsync(async () =>
        {
            var rescored = await Backend.RunAsync<CandidateRequirementService, int>(s => s.SetExperienceAsync(profile, years));
            return $"{profile}: {(years is { } y ? Wording.Years(y) : "anos apagados")}. {Wording.Listings(rescored)} com nota nova.";
        });

    private async Task SaveAsync(Func<Task<string>> save)
    {
        Busy = true;
        _message = "Salvando…";
        try
        {
            _message = await save();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = $"Não foi salvo: {ex.Message}";
        }
        finally
        {
            Busy = false;
        }
    }

    private static double? ParseYears(string? value) =>
        double.TryParse(value, System.Globalization.NumberStyles.AllowDecimalPoint, System.Globalization.CultureInfo.InvariantCulture, out var y)
            ? Math.Round(Math.Clamp(y, 0, 60), 1)
            : null;
}
