@page "/me"
@rendermode InteractiveServer
@inject Backend Backend

<PageTitle>About you · JobRadar AU</PageTitle>

<div class="page-head">
    <h1>About you</h1>
    <p class="muted">Where you stand on what ads ask for. Each answer is saved at once and the listings it touches are scored again.</p>
</div>

@if (_message is not null)
{
    <p class="notice" role="status">@_message</p>
}

@if (_requirements is null || _experience is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <section class="about">
        <h2>Years of experience</h2>
        <p class="muted small">In each line of work. When an ad says how many years it wants, these decide: enough is a plus, one year short a small minus, more a bigger one.</p>
        <div class="cards">
            @foreach (var (profile, years) in _experience)
            {
                <div class="card">
                    <div class="card-head">
                        <b>@profile</b>
                        <span class="muted">@(years is { } y ? Wording.Years(y) : "not set")</span>
                    </div>
                    <div class="chips" role="group" aria-label="@($"Years in {profile}")">
                        @foreach (var option in YearOptions)
                        {
                            <button type="button" class="@(years == option ? "on" : null)" disabled="@Busy"
                                    @onclick="() => SetYearsAsync(profile, option)">@Wording.YearsShort(option)</button>
                        }
                        <input type="number" min="0" max="60" step="0.5" aria-label="@($"Other number of years in {profile}")"
                               placeholder="other" disabled="@Busy" @onchange="e => SetYearsAsync(profile, ParseYears(e.Value as string))" />
                        @if (years is not null)
                        {
                            <button type="button" class="ghost" disabled="@Busy" @onclick="() => SetYearsAsync(profile, null)">Clear</button>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    @foreach (var (kind, heading, intro) in Sections)
    {
        var items = _requirements.Where(r => r.Item.Kind == kind).ToList();
        <section class="about">
            <h2>@heading</h2>
            <p class="muted small">@intro</p>
            <div class="cards">
                @foreach (var r in items)
                {
                    var (title, hint) = Wording.Requirement(r.Item.Id);
                    <div class="card">
                        <div class="card-head">
                            <b>@title</b>
                            @if (r.Profiles.Count > 0)
                            {
                                <span class="muted small">checked in @string.Join(", ", r.Profiles)</span>
                            }
                        </div>
                        @if (hint.Length > 0)
                        {
                            <p class="muted small">@hint</p>
                        }
                        <div class="segmented" role="group" aria-label="@title">
                            @foreach (var state in Enum.GetValues<RequirementState>())
                            {
                                <button type="button" class="@(r.State == state ? "on" : null)" aria-pressed="@(r.State == state ? "true" : "false")"
                                        disabled="@Busy" @onclick="() => SetStateAsync(r, state)">@Wording.StateButton(state)</button>
                            }
                        </div>
                        @if (r.IsDefault)
                        {
                            <p class="muted small">Not answered yet: weighed as “@Wording.StateButton(r.State)”.</p>
                        }
                        else
                        {
                            <button type="button" class="link small" disabled="@Busy" @onclick="() => SetStateAsync(r, null)">Back to the default</button>
                        }
                    </div>
                }
            </div>
        </section>
    }

    <p class="muted small">To see how much each one moves your listings, open <a href="requirements">Requirements</a>.</p>
}

@code {
    private static readonly double[] YearOptions = [0, 1, 2, 3, 5, 8, 10];

    private static readonly (RequirementKind Kind, string Heading, string Intro)[] Sections =
    [
        (RequirementKind.Licence, "Licences and tickets", "What you hold, what a short course would give you, and what is years away."),
        (RequirementKind.Qualification, "Qualifications", "Trades and degrees as Australia counts them."),
        (RequirementKind.Experience, "Experience an ad asks for without a number", "Used only when the ad gives no number of years."),
    ];

    private IReadOnlyList<RequirementStatus>? _requirements;
    private IReadOnlyList<(string Profile, double? Years)>? _experience;
    private string? _message;
    private bool Busy { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _requirements = await Backend.RunAsync<CandidateRequirementService, IReadOnlyList<RequirementStatus>>(s => s.ListAsync());
        _experience = await Backend.RunAsync<CandidateRequirementService, IReadOnlyList<(string, double?)>>(s => s.ExperienceAsync());
    }

    private async Task SetStateAsync(RequirementStatus requirement, RequirementState? state)
    {
        if (!requirement.IsDefault && requirement.State == state)
            return;
        await SaveAsync(async () =>
        {
            var (_, rescored) = await Backend.RunAsync<CandidateRequirementService, (RequirementItem, int)>(s => s.SetAsync(requirement.Item.Id, state));
            var title = Wording.Requirement(requirement.Item.Id).Title;
            return $"{title}: {(state is { } s ? Wording.StateButton(s) : "back to the default")}. {Wording.Listings(rescored)} scored again.";
        });
    }

    private async Task SetYearsAsync(string profile, double? years) =>
        await SaveAsync(async () =>
        {
            var rescored = await Backend.RunAsync<CandidateRequirementService, int>(s => s.SetExperienceAsync(profile, years));
            return $"{profile}: {(years is { } y ? Wording.Years(y) : "years cleared")}. {Wording.Listings(rescored)} scored again.";
        });

    private async Task SaveAsync(Func<Task<string>> save)
    {
        Busy = true;
        _message = "Saving…";
        try
        {
            _message = await save();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = $"Not saved: {ex.Message}";
        }
        finally
        {
            Busy = false;
        }
    }

    private static double? ParseYears(string? value) =>
        double.TryParse(value, System.Globalization.NumberStyles.AllowDecimalPoint, System.Globalization.CultureInfo.InvariantCulture, out var y)
            ? Math.Round(Math.Clamp(y, 0, 60), 1)
            : null;
}
