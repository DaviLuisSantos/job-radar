@page "/listing/{Source}/{SourceId}"
@inject Backend Backend
@inject TimeProvider Time

<PageTitle>@(_detail?.Record.Listing.Title ?? "Vaga") · JobRadar</PageTitle>

@if (_missing)
{
    <section class="empty">
        <h1>Vaga não encontrada</h1>
        <p>@Id nunca foi coletada.</p>
    </section>
}
else if (_detail is { } d)
{
    var listing = d.Record.Listing;
    <article class="listing">
        <header>
            <h1>@listing.Title</h1>
            <p class="meta">
                <span>@(listing.Company ?? "Empresa não informada")</span>
                <span>@Wording.Location(listing.Location)</span>
                @if (Wording.WorkType(listing.WorkType) is { Length: > 0 } wt)
                {
                    <span>@wt</span>
                }
                @if (listing.SalaryText is { } salary)
                {
                    <span class="salary">@salary</span>
                }
            </p>
            <div class="tags">
                <ListingTags Conditions="ListingConditions.Read(listing.Summary)" />
                <FactChips Facts="d.Facts" />
            </div>
            <p class="muted">
                Publicada em @(listing.PostedAt is { } posted ? Wording.Date(posted) : "—") · vista pela primeira vez em @Wording.Date(d.Record.FirstSeenAt)
                @if (listing.SourceCategory is { } category)
                {
                    <text> · @category</text>
                }
            </p>
        </header>

        @* Stays on screen while the page scrolls: deciding is what this page is for. *@
        <MudPaper Elevation="2" Class="action-bar">
            <div class="segmented" role="group" aria-label="Avaliação">
                <MudButton Size="Size.Small" Color="Color.Success" Variant="@(d.Label?.Verdict == Verdict.Good ? Variant.Filled : Variant.Outlined)"
                           OnClick="() => LabelAsync(Verdict.Good)">Boa</MudButton>
                <MudButton Size="Size.Small" Color="Color.Error" Variant="@(d.Label?.Verdict == Verdict.Bad ? Variant.Filled : Variant.Outlined)"
                           OnClick="() => LabelAsync(Verdict.Bad)">Ruim</MudButton>
                @if (d.Label is not null)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => LabelAsync(null)">Limpar</MudButton>
                }
            </div>
            <MudSelect T="ApplicationStatus?" Value="d.Application?.Status" ValueChanged="StatusAsync" Label="Candidatura"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="status-select"
                       ToStringFunc="StatusText">
                @foreach (var status in Enum.GetValues<ApplicationStatus>())
                {
                    <MudSelectItem T="ApplicationStatus?" Value="status">@Wording.Status(status)</MudSelectItem>
                }
            </MudSelect>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Href="@listing.Url.ToString()" Target="_blank"
                       rel="noopener noreferrer" EndIcon="@Icons.Material.Outlined.OpenInNew">Abrir no @listing.Id.Source</MudButton>
        </MudPaper>

        @if (_error is { } error)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@error</MudAlert>
        }

        <section class="panel why-score">
            <h2>Por que esta nota</h2>
            @if (d.Scores.Count == 0)
            {
                <p class="muted">Ainda sem nota.</p>
            }
            @foreach (var s in d.Scores)
            {
                <details open="@(s == d.Scores[0])">
                    <summary><ScoreBadge Value="s.Score.Final" /> @s.Profile</summary>
                    <Explanation Score="s.Score" />
                    <p class="muted small">Nota calculada em @Wording.When(s.ScoredAt)</p>
                </details>
            }
        </section>

        @if (d.Terms.Count > 0)
        {
            <section>
                <h2>Encontrado no anúncio inteiro</h2>
                <p class="chips">
                    @foreach (var term in d.Terms)
                    {
                        <span class="chip term">“@term”</span>
                    }
                </p>
            </section>
        }

        <section class="full-ad">
            <h2>Anúncio inteiro</h2>
            @if (d.Description is { } desc)
            {
                <p class="muted small">
                    Capturado em @Wording.When(desc.CapturedAt) · @Wording.Origin(desc.Origin) · @Wording.Number(desc.Text.Length) caracteres
                </p>
                <pre class="ad">@desc.Text</pre>
            }
            else
            {
                @if (listing.Summary is { } summary)
                {
                    <ul class="summary">
                        @foreach (var part in summary.Split(" | "))
                        {
                            <li>@part</li>
                        }
                    </ul>
                }
                <p class="muted">Não capturado. Abra o anúncio e clique em <a href="capture">Enviar ao JobRadar</a>, ou cole o texto abaixo.</p>
            }
            <details open="@(d.Description is null)">
                <summary>@(d.Description is null ? "Colar o texto do anúncio inteiro" : "Trocar por outro texto")</summary>
                <label class="notes">
                    <textarea rows="5" @bind="_pasted" @bind:event="oninput" placeholder="Texto do anúncio inteiro"></textarea>
                </label>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="SaveDescriptionAsync"
                           Disabled="@string.IsNullOrWhiteSpace(_pasted)">Salvar e recalcular a nota</MudButton>
            </details>
        </section>

        <section class="panel">
            <h2>Candidatura</h2>
            @if (d.Application?.AppliedAt is { } applied)
            {
                <p class="muted">Candidatura em @Wording.Date(applied)</p>
            }
            <label class="notes">
                Notas
                <textarea rows="4" @bind="_notes" placeholder="Recrutador, contatos, próximo passo…"></textarea>
            </label>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="SaveNotesAsync"
                       Disabled="@(_notes == d.Application?.Notes)">Salvar notas</MudButton>

            @if (d.Application is { History.Count: > 0 } app)
            {
                <h3>Histórico</h3>
                <ol class="history">
                    @foreach (var change in app.History.Reverse())
                    {
                        <li><time>@Wording.When(change.At)</time> @Wording.Status(change.To)</li>
                    }
                </ol>
            }
        </section>
    </article>
}

@code {
    [Parameter] public string Source { get; set; } = "";
    [Parameter] public string SourceId { get; set; } = "";

    private ListingDetail? _detail;
    private bool _missing;
    private string? _notes;
    private string? _error;

    private ListingId Id => new(Source, SourceId);

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _detail = await Backend.RunAsync<TriageService, ListingDetail?>(t => t.DetailAsync(Id));
        _missing = _detail is null;
        _notes = _detail?.Application?.Notes;
    }

    private Task LabelAsync(Verdict? verdict) => ActAsync(t => t.LabelAsync(Id, verdict));

    // The select has no "none": a status is only ever changed to another.
    private Task StatusAsync(ApplicationStatus? status) =>
        status is { } s ? ActAsync(t => t.SetStatusAsync(Id, s)) : Task.CompletedTask;

    private static string StatusText(ApplicationStatus? status) => status is { } s ? Wording.Status(s) : "";

    private Task SaveNotesAsync() => ActAsync(t => t.SetNotesAsync(Id, _notes));

    private string? _pasted;

    private async Task SaveDescriptionAsync()
    {
        _error = null;
        try
        {
            await Backend.RunAsync<DescriptionService>(s => s.CaptureAsync(Id, _pasted, DescriptionOrigin.Pasted));
            _pasted = null;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ListingNotFoundException or DescriptionTooShortException)
        {
            _error = ex.Message;
        }
    }

    private async Task ActAsync(Func<TrackingService, Task> action)
    {
        _error = null;
        try
        {
            await Backend.RunAsync(action);
            await LoadAsync();
        }
        catch (ListingNotFoundException ex)
        {
            _error = ex.Message;
        }
    }
}
