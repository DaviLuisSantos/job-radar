@page "/listing/{Source}/{SourceId}"
@inject Backend Backend
@inject TimeProvider Time

<PageTitle>@(_detail?.Record.Listing.Title ?? "Vaga") · JobRadar</PageTitle>

@if (_missing)
{
    <section class="empty">
        <span class="empty-icon"><Icon Path="@Icons.Material.Outlined.SearchOff" /></span>
        <h1>Vaga não encontrada</h1>
        <p>@Id nunca foi coletada.</p>
    </section>
}
else if (_detail is { } d)
{
    var listing = d.Record.Listing;
    <article class="listing">
        @if (d.Scores.Count > 0)
        {
            <a class="back" href="@($"triage/{Uri.EscapeDataString(d.Scores[0].Profile)}")">
                <Icon Path="@Icons.Material.Rounded.ArrowBack" /> @d.Scores[0].Profile
            </a>
        }
        <header class="listing-head">
            @if (d.Scores.Count > 0)
            {
                <ScoreBadge Value="d.Scores[0].Score.Final" />
            }
            <div class="listing-title">
                <h1>@listing.Title</h1>
                <p class="meta">
                    <span class="company">@(listing.Company ?? "Empresa não informada")</span>
                    <span>@Wording.Location(listing.Location)</span>
                    @if (Wording.WorkType(listing.WorkType) is { Length: > 0 } wt)
                    {
                        <span>@wt</span>
                    }
                    @if (listing.SalaryText is { } salary)
                    {
                        <span class="salary">@salary</span>
                    }
                </p>
                <div class="tags">
                    <ListingTags Conditions="ListingConditions.Read(listing.Summary)" Eligibility="@listing.Eligibility" />
                    <FactChips Facts="d.Facts" />
                </div>
                <p class="dates">
                    Publicada em @(listing.PostedAt is { } posted ? Wording.Date(posted) : "—") · vista pela primeira vez em @Wording.Date(d.Record.FirstSeenAt)
                    @if (listing.SourceCategory is { } category)
                    {
                        <text> · @category</text>
                    }
                </p>
            </div>
        </header>

        @if (_error is { } error)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@error</MudAlert>
        }

        <div class="listing-layout">
            <div class="listing-main">
                <section class="panel why-score">
                    <h2>Por que esta nota</h2>
                    @if (d.Scores.Count == 0)
                    {
                        <p class="muted">Ainda sem nota.</p>
                    }
                    @foreach (var s in d.Scores)
                    {
                        <details open="@(s == d.Scores[0])">
                            <summary>
                                <ScoreBadge Value="s.Score.Final" /> <span>@s.Profile</span>
                                <span class="when">calculada em @Wording.When(s.ScoredAt)</span>
                                <Icon Path="@Icons.Material.Rounded.ExpandMore" Class="chevron" />
                            </summary>
                            <Explanation Score="s.Score" />
                        </details>
                    }
                </section>

                @if (d.Terms.Count > 0)
                {
                    <section class="panel terms">
                        <h2>Encontrado no anúncio inteiro</h2>
                        <p class="chips">
                            @foreach (var term in d.Terms)
                            {
                                <span class="chip term">“@term”</span>
                            }
                        </p>
                    </section>
                }

                <section class="panel full-ad">
                    <h2>Anúncio inteiro</h2>
                    @if (d.Description is { } desc)
                    {
                        <p class="muted small">
                            Capturado em @Wording.When(desc.CapturedAt) · @Wording.Origin(desc.Origin) · @Wording.Number(desc.Text.Length) caracteres
                        </p>
                        <pre class="ad">@desc.Text</pre>
                    }
                    else
                    {
                        @if (listing.Summary is { } summary)
                        {
                            <ul class="summary">
                                @foreach (var part in summary.Split(" | "))
                                {
                                    <li>@part</li>
                                }
                            </ul>
                        }
                        <p class="notice">Não capturado. Abra o anúncio e clique em <a href="capture">Enviar ao JobRadar</a>, ou cole o texto abaixo.</p>
                    }
                    <details class="paste" open="@(d.Description is null)">
                        <summary>
                            @(d.Description is null ? "Colar o texto do anúncio inteiro" : "Trocar por outro texto")
                            <Icon Path="@Icons.Material.Rounded.ExpandMore" Class="chevron" />
                        </summary>
                        <label class="notes">
                            <textarea rows="5" @bind="_pasted" @bind:event="oninput" placeholder="Texto do anúncio inteiro"></textarea>
                        </label>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="SaveDescriptionAsync"
                                   Disabled="@string.IsNullOrWhiteSpace(_pasted)">Salvar e recalcular a nota</MudButton>
                    </details>
                </section>
            </div>

            @* Stays on screen while the ad scrolls: deciding is what this page is for. *@
            <aside class="listing-side">
                <section class="panel decide" aria-label="Decisão">
                    <div class="verdicts" role="group" aria-label="Avaliação">
                        <button type="button" class="act good @(d.Label?.Verdict == Verdict.Good ? "on" : "")"
                                aria-pressed="@(d.Label?.Verdict == Verdict.Good ? "true" : "false")" @onclick="() => LabelAsync(Verdict.Good)">
                            <Icon Path="@Icons.Material.Outlined.ThumbUp" /><span>Boa</span>
                        </button>
                        <button type="button" class="act bad @(d.Label?.Verdict == Verdict.Bad ? "on" : "")"
                                aria-pressed="@(d.Label?.Verdict == Verdict.Bad ? "true" : "false")" @onclick="() => LabelAsync(Verdict.Bad)">
                            <Icon Path="@Icons.Material.Outlined.ThumbDown" /><span>Ruim</span>
                        </button>
                    </div>
                    @if (d.Label is not null)
                    {
                        <button type="button" class="link-button clear" @onclick="() => LabelAsync(null)">Limpar avaliação</button>
                    }
                    <MudSelect T="ApplicationStatus?" Value="d.Application?.Status" ValueChanged="StatusAsync" Label="Candidatura"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="status-select"
                               ToStringFunc="StatusText">
                        @foreach (var status in Enum.GetValues<ApplicationStatus>())
                        {
                            <MudSelectItem T="ApplicationStatus?" Value="status">@Wording.Status(status)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@listing.Url.ToString()" Target="_blank" FullWidth="true"
                               rel="noopener noreferrer" EndIcon="@Icons.Material.Outlined.OpenInNew" DropShadow="false">Abrir no @listing.Id.Source</MudButton>
                </section>

                <section class="panel application">
                    <h2>Candidatura</h2>
                    @if (d.Application?.AppliedAt is { } applied)
                    {
                        <p class="muted small">Candidatura em @Wording.Date(applied)</p>
                    }
                    <label class="notes">
                        Notas
                        <textarea rows="4" @bind="_notes" @bind:event="oninput" placeholder="Recrutador, contatos, próximo passo…"></textarea>
                    </label>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="SaveNotesAsync"
                               Disabled="@(_notes == d.Application?.Notes)">Salvar notas</MudButton>

                    @if (d.Application is { History.Count: > 0 } app)
                    {
                        <h3>Histórico</h3>
                        <ol class="timeline">
                            @foreach (var change in app.History.Reverse())
                            {
                                <li><time>@Wording.When(change.At)</time> <span class="chip status-@change.To.ToString().ToLowerInvariant()">@Wording.Status(change.To)</span></li>
                            }
                        </ol>
                    }
                </section>
            </aside>
        </div>

        @* On a phone the panel is far down the page: the decision stays at hand at the bottom. *@
        <nav class="decide-bar" aria-label="Decisão rápida">
            <button type="button" class="act good @(d.Label?.Verdict == Verdict.Good ? "on" : "")" @onclick="() => LabelAsync(Verdict.Good)">
                <Icon Path="@Icons.Material.Outlined.ThumbUp" /><span>Boa</span>
            </button>
            <button type="button" class="act bad @(d.Label?.Verdict == Verdict.Bad ? "on" : "")" @onclick="() => LabelAsync(Verdict.Bad)">
                <Icon Path="@Icons.Material.Outlined.ThumbDown" /><span>Ruim</span>
            </button>
            <a class="act open" href="@listing.Url.ToString()" target="_blank" rel="noopener noreferrer">
                <Icon Path="@Icons.Material.Outlined.OpenInNew" /><span>Abrir</span>
            </a>
        </nav>
    </article>
}

@code {
    [Parameter] public string Source { get; set; } = "";
    [Parameter] public string SourceId { get; set; } = "";

    private ListingDetail? _detail;
    private bool _missing;
    private string? _notes;
    private string? _error;

    private ListingId Id => new(Source, SourceId);

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _detail = await Backend.RunAsync<TriageService, ListingDetail?>(t => t.DetailAsync(Id));
        _missing = _detail is null;
        _notes = _detail?.Application?.Notes;
    }

    private Task LabelAsync(Verdict? verdict) => ActAsync(t => t.LabelAsync(Id, verdict));

    // The select has no "none": a status is only ever changed to another.
    private Task StatusAsync(ApplicationStatus? status) =>
        status is { } s ? ActAsync(t => t.SetStatusAsync(Id, s)) : Task.CompletedTask;

    private static string StatusText(ApplicationStatus? status) => status is { } s ? Wording.Status(s) : "";

    private Task SaveNotesAsync() => ActAsync(t => t.SetNotesAsync(Id, _notes));

    private string? _pasted;

    private async Task SaveDescriptionAsync()
    {
        _error = null;
        try
        {
            await Backend.RunAsync<DescriptionService>(s => s.CaptureAsync(Id, _pasted, DescriptionOrigin.Pasted));
            _pasted = null;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ListingNotFoundException or DescriptionTooShortException)
        {
            _error = Wording.Error(ex);
        }
    }

    private async Task ActAsync(Func<TrackingService, Task> action)
    {
        _error = null;
        try
        {
            await Backend.RunAsync(action);
            await LoadAsync();
        }
        catch (ListingNotFoundException ex)
        {
            _error = Wording.Error(ex);
        }
    }
}
