@page "/calibration"
@inject Backend Backend

<PageTitle>Calibragem · JobRadar</PageTitle>

<div class="page-head">
    <h1>Calibragem</h1>
    <p class="muted">Quanto a nota concorda com as suas avaliações e decisões de candidatura. Mude um peso, recalcule as notas e confira de novo.</p>
    <p class="muted">Mire primeiro em @Calibration.LabelGoal vagas avaliadas por perfil, algumas com nota baixa também: a ordem de triagem “por faixa de nota” distribui essas vagas.</p>
</div>

@if (_results is null)
{
    <p class="muted">Carregando…</p>
}
else if (_results.Count == 0)
{
    <section class="empty">
        <h2>Nada avaliado ainda</h2>
        <p>Marque vagas como boas ou ruins, ou mude para Candidatei ou Descartada, e elas aparecem aqui.</p>
    </section>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th>Perfil</th>
                <th class="num">Boas</th>
                <th class="num">Ruins</th>
                <th class="num" title="De cada par (boa, ruim), quantas vezes a boa tem nota maior">Pares certos</th>
                <th class="num">Boas ≥ @Calibration.AlertThreshold</th>
                <th class="num">Ruins ≥ @Calibration.VisibleThreshold</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _results)
            {
                <tr>
                    <td><a href="@($"triage/{Uri.EscapeDataString(r.Profile)}")">@r.Profile</a></td>
                    <td class="num">@r.Good</td>
                    <td class="num">@r.Bad</td>
                    <td class="num">@(r.PairAccuracy is { } p ? p.ToString("P0", Wording.Culture) : "—")</td>
                    <td class="num">@r.GoodAtAlert / @r.Good</td>
                    <td class="num">@r.BadVisible / @r.Bad</td>
                </tr>
            }
        </tbody>
    </table>

    var misses = _results.SelectMany(r => r.Disagreements).ToList();
    <h2>Onde a nota discorda de você</h2>
    @if (misses.Count == 0)
    {
        <p class="muted">Nenhuma discordância: vagas boas com @Calibration.AlertThreshold ou mais, ruins abaixo de @Calibration.VisibleThreshold.</p>
    }
    else
    {
        <ul class="rows">
            @foreach (var m in misses)
            {
                <li class="row disagreement">
                    <ScoreBadge Value="m.Score.Final" />
                    <div class="what">
                        <a class="title" href="@Pages.Triage.ListingLink(m.Id)">@m.Title</a>
                        <div class="meta">
                            <span class="chip verdict-@m.Verdict.ToString().ToLowerInvariant()">Você: @Wording.Verdict(m.Verdict)</span>
                            <span>@m.Profile</span>
                        </div>
                        <ul class="why">
                            @foreach (var item in m.Score.Items.OrderByDescending(i => Math.Abs(i.Points)).Take(3))
                            {
                                <li><b>@Wording.Points(item.Points)</b> @Wording.Describe(item)</li>
                            }
                        </ul>
                    </div>
                </li>
            }
        </ul>
    }
}

@code {
    private IReadOnlyList<ProfileCalibration>? _results;

    protected override async Task OnInitializedAsync() =>
        _results = await Backend.RunAsync<CalibrationService, IReadOnlyList<ProfileCalibration>>(c => c.MeasureAsync());
}
