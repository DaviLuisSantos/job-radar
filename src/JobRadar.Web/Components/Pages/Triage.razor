@page "/triage/{Profile}"
@inject Backend Backend
@inject TimeProvider Time
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@Profile · Triagem · JobRadar</PageTitle>

<div class="page-head">
    <h1>@Profile</h1>
    <p class="muted">@(_page is null ? "Carregando…" : $"{Wording.Listings(_page.Total)}{(_filter.OnlyUntriaged ? " para triar" : "")}")</p>
    @if (_judged is { } judged)
    {
        <p class="progress" title="Suas avaliações, mais Candidatei (conta como boa) e Descartada (conta como ruim)">
            Avaliadas: <b>@judged.Good</b> boas · <b>@judged.Bad</b> ruins, meta @Calibration.LabelGoal
        </p>
    }
</div>

<form class="filters" @onsubmit="SearchAsync" @onsubmit:preventDefault>
    <input type="search" placeholder="Título ou empresa" aria-label="Buscar por título ou empresa" @bind="_text" />
    <label>
        Nota mínima
        <select @bind="_minScore" @bind:after="FiltersChangedAsync">
            <option value="0">qualquer</option>
            <option value="50">50+</option>
            <option value="65">65+</option>
            <option value="80">80+</option>
        </select>
    </label>
    <label title="Por faixa de nota distribui algumas vagas de cada faixa por página, para as avaliações não virem só do topo">
        Ordem
        <select @bind="_order" @bind:after="FiltersChangedAsync">
            <option value="@TriageOrder.BestFirst">melhores primeiro</option>
            <option value="@TriageOrder.AcrossScores">por faixa de nota, para avaliar</option>
        </select>
    </label>
    <label class="check"><input type="checkbox" @bind="_showHandled" @bind:after="FiltersChangedAsync" /> Mostrar tratadas</label>
    <label class="check"><input type="checkbox" @bind="_showExcluded" @bind:after="FiltersChangedAsync" /> Mostrar excluídas</label>
    <button type="submit" class="ghost">Buscar</button>
</form>

@if (_error is { } error)
{
    <p class="alert" role="alert">@error</p>
}

@if (_undo is { } undo)
{
    <p class="undo" role="status">
        <span>“@undo.Row.Title” marcada como @Wording.Verdict(undo.Verdict).ToLowerInvariant().</span>
        <button class="ghost" @onclick="UndoAsync">Desfazer</button>
    </p>
}

@if (_page is { Rows.Count: 0 })
{
    <section class="empty">
        <h2>Nada por aqui</h2>
        <p>@(_filter.OnlyUntriaged ? "Todas as vagas desta visão já foram tratadas." : "Nenhuma vaga atende a estes filtros.")</p>
    </section>
}
else if (_page is not null)
{
    <p class="keys muted small">
        Teclas, com uma linha selecionada: <kbd>j</kbd> <kbd>k</kbd> movem · <kbd>g</kbd> boa · <kbd>b</kbd> ruim · <kbd>u</kbd> desfaz · <kbd>o</kbd> abre
    </p>

    <ul class="rows" @onkeydown="KeyAsync">
        @foreach (var (row, index) in _page.Rows.Select((r, i) => (r, i)))
        {
            <li class="row @(index == _cursor ? "current" : "") @(_busy.Contains(row.Id) ? "busy" : "")" @key="row.Id"
                tabindex="-1" @onclick="() => _cursor = index">
                <ScoreBadge Value="row.Score" />
                <div class="what">
                    <a class="title" href="@ListingLink(row.Id)">@row.Title</a>
                    <div class="meta">
                        <span>@(row.Company ?? "Empresa não informada")</span>
                        <span>@Wording.Location(row.Location)@(row.OtherLocations.Count > 0 ? $" +{row.OtherLocations.Count} outros" : "")</span>
                        @if (Wording.WorkType(row.WorkType) is { Length: > 0 } wt)
                        {
                            <span>@wt</span>
                        }
                        @if (row.SalaryText is { } salary)
                        {
                            <span class="salary">@salary</span>
                        }
                    </div>
                    <FactChips Facts="row.Facts" />
                </div>
                <div class="state">
                    <span class="age" title="@(row.PostedAt is { } posted ? Wording.Date(posted) : null)">@Wording.Age(row.PostedAt, Time.GetUtcNow())</span>
                    @if (row.Copies.Count > 0)
                    {
                        <span class="chip" title="@CopiesTitle(row)">publicada @(row.Copies.Count + 1)×</span>
                    }
                    @if (row.Status is { } status)
                    {
                        <span class="chip status-@status.ToString().ToLowerInvariant()">@Wording.Status(status)</span>
                    }
                    @if (row.Verdict is { } verdict)
                    {
                        <span class="chip verdict-@verdict.ToString().ToLowerInvariant()">@Wording.Verdict(verdict)</span>
                    }
                </div>
                <div class="actions" role="group" aria-label="Triagem de @row.Title">
                    <button class="good" title="Boa (g)" @onclick="() => LabelAsync(row, Verdict.Good)">Boa</button>
                    <button class="bad" title="Ruim (b)" @onclick="() => LabelAsync(row, Verdict.Bad)">Ruim</button>
                    <button title="Marcar como Candidatei" @onclick="() => StatusAsync(row, ApplicationStatus.Applied)">Candidatei</button>
                    <button class="ghost" title="Não é para mim (conta como ruim)" @onclick="() => StatusAsync(row, ApplicationStatus.Dismissed)">Descartar</button>
                </div>
            </li>
        }
    </ul>

    <nav class="pager" aria-label="Páginas">
        <button class="ghost" disabled="@(_filter.Page <= 1)" @onclick="() => GoToAsync(_filter.Page - 1)">← Anterior</button>
        <span>Página @_filter.Page de @Pages</span>
        <button class="ghost" disabled="@(_filter.Page >= Pages)" @onclick="() => GoToAsync(_filter.Page + 1)">Próxima →</button>
    </nav>
}

@code {
    [Parameter] public string Profile { get; set; } = "";

    private TriageFilter _filter = new("");
    private TriagePage? _page;
    private (int Good, int Bad)? _judged;
    private string? _text;
    private string? _error;
    private readonly HashSet<ListingId> _busy = [];

    // Keyboard triage: the selected row (set by clicks and keys, never by focus events: Blazor moves
    // the focus back to a reordered row by itself), and whether it takes the focus after the next render.
    private int _cursor;
    private bool _focusCursor;

    /// <summary>The last label, to put back what was there before.</summary>
    private sealed record LastLabel(TriageRow Row, Verdict? Previous, Verdict Verdict);
    private LastLabel? _undo;

    private int Pages => _page is null ? 1 : Math.Max(1, (int)Math.Ceiling(_page.Total / (double)_filter.PageSize));

    private int _minScore;
    private TriageOrder _order;
    private bool _showHandled;
    private bool _showExcluded;

    protected override async Task OnParametersSetAsync()
    {
        if (_filter.Profile == Profile)
            return;
        _filter = new TriageFilter(Profile);
        (_text, _minScore, _order, _showHandled, _showExcluded) = (null, 0, TriageOrder.BestFirst, false, false);
        (_cursor, _undo) = (0, null);
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusCursor || _page is not { Rows.Count: > 0 })
            return;
        _focusCursor = false;
        await JS.InvokeVoidAsync("jobRadar.focusRow", _cursor);
    }

    private Task FiltersChangedAsync()
    {
        _filter = _filter with
        {
            Text = _text, MinScore = _minScore, Order = _order, OnlyUntriaged = !_showHandled, IncludeExcluded = _showExcluded, Page = 1,
        };
        _cursor = 0;
        return LoadAsync();
    }

    private Task SearchAsync() => FiltersChangedAsync();

    private Task GoToAsync(int page)
    {
        _filter = _filter with { Page = page };
        _cursor = 0;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _page = await Backend.RunAsync<TriageService, TriagePage>(t => t.ListAsync(_filter));
        _cursor = Math.Clamp(_cursor, 0, Math.Max(0, _page.Rows.Count - 1));
        var calibration = await Backend.RunAsync<CalibrationService, IReadOnlyList<ProfileCalibration>>(c => c.MeasureAsync());
        _judged = calibration.FirstOrDefault(c => c.Profile == Profile) is { } p ? (p.Good, p.Bad) : (0, 0);
    }

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        if (_page is not { Rows.Count: > 0 } page || e.CtrlKey || e.AltKey || e.MetaKey)
            return;
        var row = page.Rows[_cursor];
        switch (e.Key)
        {
            case "j":
                (_cursor, _focusCursor) = (Math.Min(_cursor + 1, page.Rows.Count - 1), true);
                break;
            case "k":
                (_cursor, _focusCursor) = (Math.Max(_cursor - 1, 0), true);
                break;
            case "g":
                await LabelAsync(row, Verdict.Good);
                break;
            case "b":
                await LabelAsync(row, Verdict.Bad);
                break;
            case "u":
                await UndoAsync();
                break;
            case "o":
                Nav.NavigateTo(ListingLink(row.Id));
                break;
        }
    }

    // A row stands for the job and its copies: the decision applies to all of them, or the next
    // copy would take its place in the list.
    private async Task LabelAsync(TriageRow row, Verdict verdict)
    {
        if (await ActAsync(row.Id, async t => { foreach (var id in row.AllIds) await t.LabelAsync(id, verdict); }))
            _undo = new LastLabel(row, row.Verdict, verdict);
    }

    private async Task UndoAsync()
    {
        if (_undo is not { } undo)
            return;
        _undo = null;
        if (await ActAsync(undo.Row.Id, async t => { foreach (var id in undo.Row.AllIds) await t.LabelAsync(id, undo.Previous); }) &&
            _page?.Rows.ToList().FindIndex(r => r.Id == undo.Row.Id) is >= 0 and var back)
            _cursor = back;
    }

    private Task StatusAsync(TriageRow row, ApplicationStatus status) =>
        ActAsync(row.Id, async t => { foreach (var id in row.AllIds) await t.SetStatusAsync(id, status); });

    private static string CopiesTitle(TriageRow row) =>
        row.OtherLocations.Count > 0 ? $"Também em: {string.Join(", ", row.OtherLocations)}" : "Republicada com o mesmo título e a mesma empresa";

    /// <returns>Whether the action went through.</returns>
    private async Task<bool> ActAsync(ListingId id, Func<TrackingService, Task> action)
    {
        _error = null;
        _busy.Add(id);
        try
        {
            await Backend.RunAsync(action);
            await LoadAsync();
            _focusCursor = true;
            return true;
        }
        catch (ListingNotFoundException ex)
        {
            _error = ex.Message;
            return false;
        }
        finally
        {
            _busy.Remove(id);
        }
    }

    internal static string ListingLink(ListingId id) =>
        $"listing/{Uri.EscapeDataString(id.Source)}/{Uri.EscapeDataString(id.SourceId)}";
}
