@page "/status"
@using JobRadar.Application.Operations
@using JobRadar.Domain.Market
@inject Backend Backend
@inject IWebHostEnvironment Environment

<PageTitle>Status · JobRadar</PageTitle>

<div class="page-head">
    <h1>Pipeline status</h1>
    <p class="muted">Collection, full-text terms, scoring and the market snapshot run once a day.</p>
</div>

@if (_status is { } s)
{
    <section class="panel status-summary">
        @if (s.LastRunMissed)
        {
            <p class="alert" role="alert">The last scheduled run did not start. The worker runs it as soon as it is back up.</p>
        }
        <dl>
            <dt>Next run</dt>
            <dd>@s.NextRun.ToString("ddd d MMM, HH:mm") (schedule time zone) · @Wording.When(s.NextRun) here</dd>
            <dt>Last start</dt>
            <dd>@(s.LastStart is { } last ? Wording.When(last) : "never")</dd>
            <dt>Deployed</dt>
            <dd>@(_deployment?.Deployed ?? "no deploy record (not installed by deploy.ps1)")@(_deployment?.Build is { } build ? $" · this build {build}" : "")</dd>
        </dl>
    </section>

    @if (s.LastPass is { } pass)
    {
        var problems = pass.Problems;
        <h2>Last pass</h2>
        <p class="muted">
            @Wording.When(pass.StartedAt) to @Wording.When(pass.FinishedAt) · @pass.Runs.Count runs (searches and terms) ·
            @(problems.Count == 0 ? "every one succeeded and saw its whole window." : $"{problems.Count} failed or incomplete:")
        </p>
        @if (problems.Count > 0)
        {
            <table class="grid">
                <thead>
                    <tr>
                        <th>Search or term</th>
                        <th>Source</th>
                        <th>Outcome</th>
                        <th class="num">Found</th>
                        <th>Error</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in problems)
                    {
                        <tr class="@(r.Succeeded ? "" : "warn")">
                            <td>@r.SearchKey</td>
                            <td>@r.Source</td>
                            <td>@(r.Succeeded ? "Incomplete" : "Failed")</td>
                            <td class="num">@r.Found.ToString("N0")</td>
                            <td title="@r.Error">@Wording.Shorten(r.Error, 160)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    <h2>Collection, by day</h2>
    @if (s.Days.Count == 0)
    {
        <p class="muted">No runs yet.</p>
    }
    else
    {
        <table class="grid">
            <thead>
                <tr>
                    <th>Day</th>
                    <th class="num">Runs</th>
                    <th class="num" title="Searches or terms that raised an error">Failed</th>
                    <th class="num" title="Stopped at the source cap: more listings exist">Incomplete</th>
                    <th class="num">Found</th>
                    <th class="num">New</th>
                    <th>Finished</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in s.Days)
                {
                    <tr class="@(d.Failed > 0 ? "warn" : "")">
                        <td>@d.Day.ToString("ddd d MMM")</td>
                        <td class="num">@d.Runs</td>
                        <td class="num">@d.Failed</td>
                        <td class="num">@d.Incomplete</td>
                        <td class="num">@d.Found.ToString("N0")</td>
                        <td class="num">@d.New.ToString("N0")</td>
                        <td>@Wording.When(d.LastFinished)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>Market snapshots</h2>
    @if (s.Snapshots.Count == 0)
    {
        <p class="muted">No snapshot yet.</p>
    }
    else
    {
        <ul class="rows">
            @foreach (var snap in s.Snapshots)
            {
                <li class="row disagreement">
                    <span class="chip snapshot-@snap.Status.ToString().ToLowerInvariant()">@snap.Status</span>
                    <div class="what">
                        <span class="title">@snap.Date.ToString("ddd d MMM yyyy")</span>
                        <div class="meta"><span>@snap.Saved / @snap.Expected counts</span><span>@snap.Listings listings</span></div>
                        @if (snap.Issues.Count > 0)
                        {
                            <ul class="why">
                                @foreach (var issue in snap.Issues)
                                {
                                    <li>@issue</li>
                                }
                            </ul>
                        }
                    </div>
                </li>
            }
        </ul>
    }
}
else
{
    <p class="muted">Loading…</p>
}

@code {
    private PipelineStatus? _status;
    private Deployment? _deployment;

    protected override async Task OnInitializedAsync()
    {
        _deployment = Deployment.Read(Environment.ContentRootPath);
        _status = await Backend.RunAsync<StatusService, PipelineStatus>(s => s.GetAsync());
    }
}
