@page "/status"
@using JobRadar.Application.Operations
@using JobRadar.Domain.Market
@inject Backend Backend
@inject IWebHostEnvironment Environment

<PageTitle>Status · JobRadar</PageTitle>

<div class="page-head">
    <h1>Status da passada diária</h1>
    <p class="muted">Coleta, termos do texto completo, notas e retrato do mercado rodam uma vez por dia.</p>
</div>

@if (_status is { } s)
{
    <section class="panel status-summary">
        @if (s.LastRunMissed)
        {
            <p class="alert" role="alert">A última passada agendada não começou. O worker roda assim que voltar.</p>
        }
        <dl>
            <dt>Próxima passada</dt>
            <dd>@s.NextRun.ToString("ddd d MMM, HH:mm", Wording.Culture) (fuso do agendamento) · @Wording.When(s.NextRun) aqui</dd>
            <dt>Último início</dt>
            <dd>@(s.LastStart is { } last ? Wording.When(last) : "nunca")</dd>
            <dt>Implantado</dt>
            <dd>@(_deployment?.Deployed ?? "sem registro de implantação (não instalado pelo deploy.ps1)")@(_deployment?.Build is { } build ? $" · este build {build}" : "")</dd>
        </dl>
    </section>

    @if (s.LastPass is { } pass)
    {
        var problems = pass.Problems;
        <h2>Última passada</h2>
        <p class="muted">
            @Wording.When(pass.StartedAt) a @Wording.When(pass.FinishedAt) · @Wording.Number(pass.Runs.Count) execuções (buscas e termos) ·
            @(problems.Count == 0 ? "todas deram certo e viram a janela inteira." : $"{Wording.Number(problems.Count)} com falha ou incompletas:")
        </p>
        @if (problems.Count > 0)
        {
            <table class="grid">
                <thead>
                    <tr>
                        <th>Busca ou termo</th>
                        <th>Fonte</th>
                        <th>Resultado</th>
                        <th class="num">Achadas</th>
                        <th title="A mensagem da exceção, como o worker a gravou: é texto técnico, em inglês">Erro técnico</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in problems)
                    {
                        <tr class="@(r.Succeeded ? "" : "warn")">
                            <td>@r.SearchKey</td>
                            <td>@r.Source</td>
                            <td>@(r.Succeeded ? "Incompleta" : "Falhou")</td>
                            <td class="num">@Wording.Number(r.Found)</td>
                            <td title="@r.Error">@Wording.Shorten(r.Error, 160)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    <h2>Coleta, por dia</h2>
    @if (s.Days.Count == 0)
    {
        <p class="muted">Nenhuma execução ainda.</p>
    }
    else
    {
        <table class="grid">
            <thead>
                <tr>
                    <th>Dia</th>
                    <th class="num">Execuções</th>
                    <th class="num" title="Buscas ou termos que deram erro">Com falha</th>
                    <th class="num" title="Pararam no limite da fonte: existem mais vagas">Incompletas</th>
                    <th class="num">Achadas</th>
                    <th class="num">Novas</th>
                    <th>Terminou</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in s.Days)
                {
                    <tr class="@(d.Failed > 0 ? "warn" : "")">
                        <td>@d.Day.ToString("ddd d MMM", Wording.Culture)</td>
                        <td class="num">@Wording.Number(d.Runs)</td>
                        <td class="num">@Wording.Number(d.Failed)</td>
                        <td class="num">@Wording.Number(d.Incomplete)</td>
                        <td class="num">@Wording.Number(d.Found)</td>
                        <td class="num">@Wording.Number(d.New)</td>
                        <td>@Wording.When(d.LastFinished)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>Retratos do mercado</h2>
    @if (s.Snapshots.Count == 0)
    {
        <p class="muted">Nenhum retrato ainda.</p>
    }
    else
    {
        <ul class="rows">
            @foreach (var snap in s.Snapshots)
            {
                <li class="row disagreement">
                    <span class="chip snapshot-@snap.Status.ToString().ToLowerInvariant()">@Wording.Snapshot(snap.Status)</span>
                    <div class="what">
                        <span class="title">@snap.Date.ToString("ddd d MMM yyyy", Wording.Culture)</span>
                        <div class="meta"><span>@Wording.Number(snap.Saved) / @Wording.Number(snap.Expected) contagens</span><span>@Wording.Listings(snap.Listings)</span></div>
                        @if (snap.Issues.Count > 0)
                        {
                            <ul class="why">
                                @foreach (var issue in snap.Issues)
                                {
                                    <li>@issue</li>
                                }
                            </ul>
                        }
                    </div>
                </li>
            }
        </ul>
    }
}
else
{
    <p class="muted">Carregando…</p>
}

@code {
    private PipelineStatus? _status;
    private Deployment? _deployment;

    protected override async Task OnInitializedAsync()
    {
        _deployment = Deployment.Read(Environment.ContentRootPath);
        _status = await Backend.RunAsync<StatusService, PipelineStatus>(s => s.GetAsync());
    }
}
