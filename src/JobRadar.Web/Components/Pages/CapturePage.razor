@page "/capture"
@implements IDisposable
@inject Backend Backend
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Captura · JobRadar</PageTitle>

<div class="page-head">
    <h1>Capturar um anúncio inteiro</h1>
    <p class="muted">A nota lê o texto inteiro dos anúncios que você captura. O texto fica no seu banco de dados.</p>
</div>

@if (_id is { } id)
{
    <section class="panel capture">
        @if (_missing)
        {
            <p class="alert" role="alert">@id nunca foi coletada: nenhuma busca de perfil a encontrou, então não há o que pontuar.</p>
        }
        else if (_detail is { } d)
        {
            <h2><a href="@Pages.Triage.ListingLink(id)">@d.Record.Listing.Title</a></h2>
            <p class="meta">
                <span>@(d.Record.Listing.Company ?? "Empresa não informada")</span>
                <span>@Wording.Location(d.Record.Listing.Location)</span>
            </p>
        }

        <label class="notes">
            @(_received ? "Recebido da página do anúncio. Confira e salve." : "O texto do anúncio chega aqui pelo favorito. Se não chegar, cole (Ctrl+V).")
            <textarea rows="14" @bind="_text" @bind:event="oninput" placeholder="Texto do anúncio inteiro"></textarea>
        </label>
        <button @onclick="SaveAsync" disabled="@(_busy || _missing || string.IsNullOrWhiteSpace(_text))">Salvar e recalcular a nota</button>

        @if (_error is { } error)
        {
            <p class="alert" role="alert">@error</p>
        }
        @if (_result is { } result)
        {
            <h3>Nova nota</h3>
            @if (result.Scores.Count == 0)
            {
                <p class="muted">Salvo. Nenhum perfil pontua esta vaga.</p>
            }
            <ul class="rows">
                @foreach (var s in result.Scores)
                {
                    <li class="row disagreement">
                        <ScoreBadge Value="s.Score.Final" />
                        <div class="what">
                            <a class="title" href="@Pages.Triage.ListingLink(id)">@s.Profile</a>
                            <ul class="why">
                                @foreach (var item in s.Score.Items.Where(i => i.Where == ScoreWhere.Description))
                                {
                                    <li><b>@Wording.Points(item.Points)</b> @Wording.Describe(item)</li>
                                }
                            </ul>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
}

<section class="panel setup">
    <h2>Favorito</h2>
    <p>Arraste este botão para a barra de favoritos do navegador: <a class="button bookmarklet" href="@BookmarkletHref" @onclick:preventDefault>Enviar ao JobRadar</a></p>
    <ol class="steps">
        <li>Abra um anúncio de vaga no Seek, no seu próprio navegador.</li>
        <li>Clique em <b>Enviar ao JobRadar</b>. Se a página mudou e o texto do anúncio não for encontrado, selecione o texto antes.</li>
        <li>Esta página abre com o texto. Confira e salve: a vaga ganha nota nova na hora.</li>
    </ol>
    <p class="muted small">O favorito só lê a página que você abriu; o JobRadar nunca abre páginas de anúncio do Seek. Ele também copia o texto, então colar funciona quando o navegador mantém as duas páginas separadas.</p>
</section>

@code {
    [SupplyParameterFromQuery] public string? Source { get; set; }
    [SupplyParameterFromQuery(Name = "id")] public string? SourceId { get; set; }

    private ListingId? _id;
    private ListingDetail? _detail;
    private bool _missing;
    private string? _text;
    private string? _receivedText;
    private bool _received;
    private bool _busy;
    private string? _error;
    private CaptureResult? _result;
    private DotNetObjectReference<CapturePage>? _ref;

    private string BookmarkletHref => Bookmarklet.For(new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority));

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Source) && !string.IsNullOrWhiteSpace(SourceId) && !Source.Contains(':'))
            await OpenAsync(new ListingId(Source, SourceId));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        _ref = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("jobRadarCapture.listen", _ref);
    }

    [JSInvokable]
    public async Task Receive(string source, string sourceId, string text)
    {
        if (string.IsNullOrWhiteSpace(source) || string.IsNullOrWhiteSpace(sourceId) || source.Contains(':'))
            return;
        var id = new ListingId(source, sourceId);
        if (_id != id)
            await OpenAsync(id);
        (_text, _receivedText, _received) = (text, text, true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenAsync(ListingId id)
    {
        (_id, _result, _error) = (id, null, null);
        _detail = await Backend.RunAsync<TriageService, ListingDetail?>(t => t.DetailAsync(id));
        _missing = _detail is null;
    }

    private async Task SaveAsync()
    {
        if (_id is not { } id)
            return;
        (_busy, _error) = (true, null);
        try
        {
            // Edited after it arrived? Then it is the candidate's text, not the page's.
            var origin = _received && _text == _receivedText ? DescriptionOrigin.Browser : DescriptionOrigin.Pasted;
            _result = await Backend.RunAsync<DescriptionService, CaptureResult>(s => s.CaptureAsync(id, _text, origin));
        }
        catch (Exception ex) when (ex is ListingNotFoundException or DescriptionTooShortException)
        {
            _error = Wording.Error(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose() => _ref?.Dispose();
}
