@page "/requirements"
@inject Backend Backend

<PageTitle>Requisitos · JobRadar</PageTitle>

<div class="page-head">
    <h1>Requisitos</h1>
    <p class="muted">O que os anúncios pedem e onde você está em cada item. Um anúncio que pede algo que você tem ganha nota maior; um que pede o que falta, menor, tanto mais quanto mais difícil de conseguir.</p>
</div>

@if (_message is not null)
{
    <p class="notice" role="status">@_message</p>
}

@if (_requirements is null)
{
    <p class="muted">Carregando…</p>
}
else
{
    @if (_experience is { Count: > 0 })
    {
        <section class="experience">
            <h2>Anos de experiência</h2>
            <p class="muted small">Em cada área. Quando um anúncio diz quantos anos pede, estes decidem; em branco, a experiência pesa como um requisito que falta.</p>
            <div class="years">
                @foreach (var (profile, years) in _experience)
                {
                    <label>
                        @profile
                        <input type="number" min="0" max="60" step="0.5" value="@years?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               disabled="@(_saving is not null)" @onchange="e => SetYearsAsync(profile, e.Value as string)" />
                    </label>
                }
            </div>
        </section>
    }

    <table class="grid requirements">
        <thead>
            <tr>
                <th>Requisito</th>
                <th>Tipo</th>
                <th>Você</th>
                <th title="Vagas cuja nota mudaria se você tivesse o item, e quantas delas chegam a @Calibration.VisibleThreshold e a @Calibration.AlertThreshold sem → com ele">Se você tivesse</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _requirements)
            {
                <tr>
                    <td>
                        <b>@r.Item.Id</b>
                        <div class="muted small">@string.Join(" · ", r.Item.Phrases)</div>
                    </td>
                    <td>@Wording.Kind(r.Item.Kind)</td>
                    <td>
                        <select aria-label="@($"Sua situação em {r.Item.Id}")" disabled="@(_saving is not null)"
                                value="@(r.IsDefault ? Default : Value(r.State))" @onchange="e => SetAsync(r, e.Value as string)">
                            <option value="@Default">@($"Padrão: {Wording.State(r.State)}")</option>
                            @foreach (var state in Enum.GetValues<RequirementState>())
                            {
                                <option value="@Value(state)">@Wording.State(state)</option>
                            }
                        </select>
                        @if (_saving == r.Item.Id)
                        {
                            <span class="muted small">Salvando e recalculando as notas…</span>
                        }
                    </td>
                    <td>
                        @if (_impact is null)
                        {
                            <span class="muted small">Medindo…</span>
                        }
                        else if (_impact.Where(i => i.ItemId == r.Item.Id && i.Affected > 0).ToList() is { Count: > 0 } moves)
                        {
                            <ul class="impact">
                                @foreach (var i in moves)
                                {
                                    <li>
                                        <b>@i.Profile</b>: @Wording.Listings(i.Affected) mudam ·
                                        ≥ @Calibration.VisibleThreshold <span class="num">@i.VisibleWithout → @i.VisibleWith</span> ·
                                        ≥ @Calibration.AlertThreshold <span class="num">@i.AlertWithout → @i.AlertWith</span>
                                        @if (i.Good + i.Bad > 0)
                                        {
                                            <span class="muted"> · avaliadas: @i.Good boas, @i.Bad ruins</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="muted small">Nenhuma vaga mudaria</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="muted small">
        As vagas avaliadas que mudariam foram avaliadas na situação em que você estava: se você tirar uma licença, vagas que
        marcou como ruins por pedi-la podem ser boas agora.
    </p>
}

@code {
    private const string Default = "default";

    private IReadOnlyList<RequirementStatus>? _requirements;
    private IReadOnlyList<RequirementImpact>? _impact;
    private string? _saving;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _ = MeasureAsync();
    }

    private IReadOnlyList<(string Profile, double? Years)>? _experience;

    private async Task LoadAsync()
    {
        _requirements = await Backend.RunAsync<CandidateRequirementService, IReadOnlyList<RequirementStatus>>(s => s.ListAsync());
        _experience = await Backend.RunAsync<CandidateRequirementService, IReadOnlyList<(string, double?)>>(s => s.ExperienceAsync());
    }

    private async Task SetYearsAsync(string profile, string? value)
    {
        double? years = double.TryParse(value, System.Globalization.NumberStyles.AllowDecimalPoint,
            System.Globalization.CultureInfo.InvariantCulture, out var y) ? Math.Round(Math.Clamp(y, 0, 60), 1) : null;
        _saving = profile;
        _message = null;
        var rescored = await Backend.RunAsync<CandidateRequirementService, int>(s => s.SetExperienceAsync(profile, years));
        await LoadAsync();
        _saving = null;
        _message = $"{profile}: {(years is { } v ? $"{Wording.Years(v)} de experiência" : "anos apagados")}. {Wording.Number(rescored)} notas atualizadas agora.";
        _ = MeasureAsync();
    }

    // Scores every listing of every profile twice per item: seconds, so it fills in after the page shows.
    private async Task MeasureAsync()
    {
        _impact = null;
        try
        {
            var impact = await Backend.RunAsync<CandidateRequirementService, IReadOnlyList<RequirementImpact>>(s => s.ImpactAsync());
            await InvokeAsync(() =>
            {
                _impact = impact;
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                _impact = [];
                _message = $"Não deu para medir o impacto: {Wording.Error(ex)}";
                StateHasChanged();
            });
        }
    }

    private async Task SetAsync(RequirementStatus requirement, string? value)
    {
        RequirementState? state = value == Default ? null : Enum.GetValues<RequirementState>().First(s => Value(s) == value);
        _saving = requirement.Item.Id;
        _message = null;
        var (item, rescored) = await Backend.RunAsync<CandidateRequirementService, (RequirementItem, int)>(s => s.SetAsync(requirement.Item.Id, state));
        await LoadAsync();
        _saving = null;
        _message = $"{item.Id}: {(state is { } s ? Wording.State(s) : "de volta ao padrão")}. {Wording.Number(rescored)} notas atualizadas agora; as demais na próxima passada diária.";
        _ = MeasureAsync();
    }

    private static string Value(RequirementState state) => state.ToString().ToLowerInvariant();
}
