@page "/Error"
@using System.Diagnostics
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Erro · JobRadar</PageTitle>

<h1 class="text-danger">Erro.</h1>
<h2 class="text-danger">Ocorreu um erro ao processar a sua requisição.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>ID da requisição:</strong> <code>@RequestId</code>
    </p>
}

<h3>Modo de desenvolvimento</h3>
<p>
    Trocar para o ambiente <strong>Development</strong> mostra informações mais detalhadas sobre o erro.
</p>
<p>
    <strong>O ambiente Development não deve ser ativado em aplicações implantadas.</strong>
    Ele pode mostrar a quem usa o site informações sensíveis das exceções.
    Para depurar localmente, ative o ambiente <strong>Development</strong> definindo a variável de ambiente <strong>ASPNETCORE_ENVIRONMENT</strong> como <strong>Development</strong>
    e reiniciando a aplicação.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
