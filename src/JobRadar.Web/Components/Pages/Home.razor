@page "/"
@inject Backend Backend
@inject NavigationManager Nav

<PageTitle>JobRadar</PageTitle>

@if (_loaded)
{
    <section class="empty">
        <h1>Nenhuma nota ainda</h1>
        <p>Descreva seus perfis em <code>appsettings.Local.json</code> e deixe o worker rodar uma passada:</p>
        <pre>dotnet run --project src/JobRadar.Worker -- --Collection:RunOnStartup=true</pre>
    </section>
}

@code {
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        var profiles = await Backend.RunAsync<TriageService, IReadOnlyList<string>>(t => t.ProfilesAsync());
        if (profiles.Count > 0)
            Nav.NavigateTo($"triage/{Uri.EscapeDataString(profiles[0])}");
        _loaded = true;
    }
}
