@page "/"
@inject Backend Backend
@inject NavigationManager Nav
@inject ProfileCatalog Catalog

<PageTitle>JobRadar</PageTitle>

@if (_loaded)
{
    <section class="empty">
        <h1>Nenhuma nota ainda</h1>
        <p>Descreva seus perfis em <code>appsettings.Local.json</code> e deixe o worker rodar uma passada:</p>
        <pre>dotnet run --project src/JobRadar.Worker -- --Collection:RunOnStartup=true</pre>
    </section>
}

@code {
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        var profiles = await Backend.RunAsync<TriageService, IReadOnlyList<string>>(t => t.ProfilesAsync());
        // The first market's "Today": what arrived since the last visit.
        if (ProfileMenu.Groups(Catalog.Profiles, profiles).FirstOrDefault(g => g.Profiles.Count > 0) is { } first && profiles.Count > 0)
            Nav.NavigateTo(ProfileMenu.TodayHref(first.Market));
        _loaded = true;
    }
}
