@page "/hoje/{Slug}"
@inject Backend Backend
@inject ProfileCatalog Catalog
@inject TimeProvider Time

<PageTitle>@Wording.Today · @_label · JobRadar</PageTitle>

@if (_unknown)
{
    <section class="empty">
        <span class="empty-icon"><Icon Path="@Icons.Material.Outlined.Public" /></span>
        <h1>Mercado desconhecido</h1>
        <p>“@Slug” não é um dos mercados.</p>
    </section>
}
else if (_today is { } t)
{
    <header class="page-head">
        <div class="page-title">
            <p class="eyebrow">@Wording.Today</p>
            <h1>@_label</h1>
        </div>
        <p class="head-stats">@Wording.SinceVisit(t.LastVisit)</p>
    </header>

    <div class="stats">
        <p class="stat today-total"><b>@Wording.Number(t.New)</b><span>@Wording.NewListingsWord(t.New)</span></p>
        <p class="stat"><b>@Wording.Number(t.Fresh)</b><span>@Wording.FreshListingsWord(t.Fresh)</span></p>
        <p class="stat"><b>@Wording.Number(t.Changes.Count)</b><span>@Wording.ApplicationsMovedWord(t.Changes.Count)</span></p>
    </div>

    <div class="cards today-cards">
        @foreach (var p in t.Profiles)
        {
            <section class="card today-profile @(p.New == 0 ? "quiet" : "")">
                <div class="card-head">
                    <h2><a href="@TriageHref(p.Profile)">@p.Profile</a></h2>
                    <span class="new @(p.New > 0 ? "some" : "")">
                        @Wording.NewListings(p.New)
                        @if (p.Fresh > 0)
                        {
                            <span class="chip fresh">@Wording.FreshListings(p.Fresh)</span>
                        }
                    </span>
                </div>
                @if (p.Best.Count == 0)
                {
                    <p class="muted small">@Wording.NothingNew</p>
                }
                else
                {
                    <ol class="today-best">
                        @foreach (var row in p.Best)
                        {
                            <li>
                                <a class="best" href="@Triage.ListingLink(row.Id)">
                                    <ScoreBadge Value="row.Score" />
                                    <span class="best-text">
                                        <span class="title">
                                            @row.Title
                                            @if (t.IsFresh(row))
                                            {
                                                <span class="chip fresh">@Wording.JustArrived</span>
                                            }
                                        </span>
                                        <span class="meta">
                                            <span>@(row.Company ?? "Empresa não informada")</span>
                                            <span>@Wording.Location(row.Location)</span>
                                        </span>
                                        <span class="tags"><ListingTags Conditions="row.Conditions" Eligibility="@row.Eligibility" /></span>
                                    </span>
                                </a>
                            </li>
                        }
                    </ol>
                }
                <a class="card-foot" href="@TriageHref(p.Profile)">Triar @p.Profile <Icon Path="@Icons.Material.Rounded.ArrowForward" /></a>
            </section>
        }
    </div>

    <section class="panel today-changes">
        <h2>@Wording.ApplicationsMoved</h2>
        @if (t.Changes.Count == 0)
        {
            <p class="muted">@Wording.NoChanges</p>
        }
        else
        {
            <ol class="timeline">
                @foreach (var c in t.Changes)
                {
                    <li>
                        <time>@Wording.When(c.At)</time>
                        <span class="chip status-@c.To.ToString().ToLowerInvariant()">@Wording.StatusMove(c.From, c.To)</span>
                        <span class="what">
                            <a href="@Triage.ListingLink(c.Id)">@c.Title</a>
                            @if (c.Company is { } company)
                            {
                                <span class="muted"> · @company</span>
                            }
                        </span>
                    </li>
                }
            </ol>
        }
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private MarketToday? _today;
    private JobMarket _market;
    private string _label = "";
    private bool _unknown;
    private bool _recorded;

    protected override async Task OnParametersSetAsync()
    {
        if (ProfileMenu.FromSlug(Slug) is not { } market)
        {
            _unknown = true;
            return;
        }
        (_unknown, _market, _label, _recorded) = (false, market, ProfileMenu.Label(market), false);
        var profiles = ProfileMenu.Groups(Catalog.Profiles, await Backend.RunAsync<TriageService, IReadOnlyList<string>>(t => t.ProfilesAsync()))
            .FirstOrDefault(g => g.Market == market)?.Profiles ?? [];
        _today = await Backend.RunAsync<TodayService, MarketToday>(s => s.TodayAsync(market, profiles, Time.GetUtcNow()));
    }

    // After the interactive render only: the prerender would record the visit before the page could show what was new.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_today is null || _recorded)
            return;
        _recorded = true;
        await Backend.RunAsync<TodayService>(s => s.RecordVisitAsync(_market, Time.GetUtcNow()));
    }

    private static string TriageHref(string profile) => $"triage/{Uri.EscapeDataString(profile)}";
}
