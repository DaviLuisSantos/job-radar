{
  "//": "Copy to appsettings.Local.json (not versioned) and describe your own profiles. Every keyword is searched in every location; the signals decide the score (see docs/plano.md, etapa 4).",
  "Matching": {
    "Markets": {
      "AU": {
        "//": "Who may apply, in the market's own words: patterns are .NET regular expressions on lower-cased text, phrases are searched in the full ad by group (exclude, doubt, ambiguous, welcome, welcome_retracted, tenure). An AU profile scores only with this block. Fictional rules: write your market's. 'eligibility AU' prints the block in use.",
        "Eligibility": {
          "RestrictedPattern": "\\bguild\\s+members?\\s+only\\b|\\bmust\\s+be\\s+a\\s+guild\\s+member\\b",
          "IncompatiblePattern": "\\blifetime\\s+guild\\s+standing\\b|\\bno\\s+seasonal\\s+members?\\b",
          "ReservedTitlePattern": "\\bguild\\s+scholarship\\b",
          "WelcomePattern": "\\bseasonal\\s+members?\\b|\\bnewcomers\\s+welcome\\b",
          "AssistanceDeniedPattern": "\\b(?:no|not|without)\\s+relocation\\b",
          "AssistanceOfferedPhrases": [ "relocation package", "we help you relocate" ],
          "AssistanceWord": "relocation",
          "Phrases": {
            "exclude": [ "lifetime guild standing" ],
            "doubt": [ "guild member" ],
            "ambiguous": [ "full guild standing" ],
            "welcome": [ "seasonal member", "newcomers welcome" ],
            "welcome_retracted": [ "seasonal member + guild member" ],
            "tenure": [ "24 months + guild standing" ]
          }
        }
      },
      "LatamRemote": {
        "//": "Remote markets read only RestrictedPattern, added to the residency phrases in code ('US only', 'must reside in').",
        "Eligibility": { "RestrictedPattern": "\\b(?:us|uk)\\s+guild\\s+members?\\s+only\\b" }
      }
    },
    "Profiles": {
      "dotnet": {
        "Keywords": [ ".NET Developer", "C# Developer" ],
        "Locations": [ "Perth WA" ],
        "PreferredLocations": [ "Perth" ],
        "AllowSenior": true,
        "EntryLevelBoost": false,
        "PositiveSignals": [ "C#", ".NET", "Azure", "contract", "6 month" ],
        "NegativeSignals": [ "on-call", "10+ years", "hospitality" ],
        "DisqualifySignals": [],
        "QualifiedTitles": []
      },
      "fifo": {
        "Keywords": [ "FIFO Labourer", "FIFO Trade Assistant" ],
        "Locations": [ "Perth WA" ],
        "PreferredLocations": [ "WA" ],
        "AllowSenior": false,
        "EntryLevelBoost": true,
        "PositiveSignals": [ "no experience", "training provided", "accommodation provided" ],
        "NegativeSignals": [ "3+ years" ],
        "DisqualifySignals": [ "trade qualified" ],
        "QualifiedTitles": [ "electrician", "operator", "driver", "social worker" ],
        "RewardRemote": false,
        "Requirements": {
          "//": "Catalog items (RequirementCatalog), searched in the full ad as phrase + context word and penalised once per kind found (weights in ScoringPolicy). Experience/Qualification/Licence add phrases the catalog lacks.",
          "Contexts": [ "FIFO" ],
          "Items": [ "experience-years", "trade-qualification", "degree", "truck-hr", "hrwl" ],
          "Experience": [ "relevant experience" ]
        }
      },
      "farm": {
        "//": "Seasonal farm work outside the city: Perth is ruled out by its location.",
        "Keywords": [ "Farm Hand", "Fruit Picker" ],
        "Locations": [ "Western Australia" ],
        "ExcludedLocations": [ "Perth WA" ],
        "PreferredLocations": [],
        "AllowSenior": false,
        "EntryLevelBoost": true,
        "PositiveSignals": [ "harvest season", "harvest", "accommodation provided" ],
        "NegativeSignals": [ "supervisor" ],
        "DisqualifySignals": [],
        "QualifiedTitles": [],
        "RewardRemote": false
      },
      "dotnet-br": {
        "//": "Brazil: Market BR (also AU, LatamRemote, GlobalRemote) is searched only on the sources serving it (Gupy) and scored by its rules. A location is a city, Remoto (work from anywhere) or Brasil (the whole country). ExcludedTitles rules a listing out by a title word; OnSiteLocations rules out on-site work anywhere else.",
        "Market": "BR",
        "Keywords": [ "desenvolvedor .net", "desenvolvedor c#" ],
        "Locations": [ "Remoto", "Rio de Janeiro" ],
        "PreferredLocations": [],
        "AllowSenior": true,
        "EntryLevelBoost": false,
        "PositiveSignals": [ ".NET", "C#", "ASP.NET Core", "Azure", "pleno" ],
        "NegativeSignals": [],
        "DisqualifySignals": [],
        "QualifiedTitles": [],
        "ExcludedTitles": [ "júnior", "junior", "estágio", "estagiário", "java", "php" ],
        "OnSiteLocations": [ "Rio de Janeiro" ]
      },
      "dotnet-latam": {
        "//": "Remote jobs open to a region with Brazil (LatamRemote; GlobalRemote takes jobs open worldwide). Sources: Himalayas and Jobicy; the location is not used. Compensation is optional: with it the profile reads how the job hires (contractor, EOR, direct) and its pay against these monthly bands. Fictional numbers.",
        "Market": "LatamRemote",
        "Keywords": [ ".NET", "C#" ],
        "Locations": [ "Remote" ],
        "PreferredLocations": [],
        "AllowSenior": true,
        "EntryLevelBoost": false,
        "RewardRemote": false,
        "PositiveSignals": [ ".NET", "C#", "ASP.NET Core", "Azure", "mid-level" ],
        "NegativeSignals": [],
        "DisqualifySignals": [],
        "QualifiedTitles": [],
        "ExcludedTitles": [ "junior", "intern", "internship", "java", "php" ],
        "Compensation": {
          "Contractor": { "Currency": "USD", "MonthlyFloor": 2500, "MonthlyTarget": 4000 },
          "Eor": { "Currency": "BRL", "MonthlyFloor": 10000, "MonthlyTarget": 15000 }
        }
      }
    },
    "Compensation": { "UsdToBrl": 5.5, "HoursPerMonth": 168 }
  }
}
