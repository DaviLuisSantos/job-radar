# Copy to .env next to docker-compose.yml (not versioned) and fill in this machine's values. Paths may be Windows
# (C:\JobRadar\...) or Unix (/srv/jobradar/...): Docker reads them on the host.

# The real profiles (Matching:Profiles): mounted read-only into the worker and the site.
JOBRADAR_PROFILES=/srv/jobradar/appsettings.Local.json

# Where deploy.ps1 keeps its records (deployed.txt, logs, the previous tag); the site reads deployed.txt from it.
JOBRADAR_STATE=/srv/jobradar/state

# The site's port on this machine, and the Tailscale address to listen on too (leave empty for localhost only).
JOBRADAR_PORT=5380
JOBRADAR_TAILSCALE_IP=
# Host names the site answers to: localhost, the Tailscale address and its MagicDNS name, separated by ';'.
JOBRADAR_ALLOWED_HOSTS=localhost

# Written by deploy.ps1 on each deploy: the image tag (short commit) and the full commit.
JOBRADAR_TAG=local
JOBRADAR_COMMIT=unknown
